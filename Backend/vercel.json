{
    "buildCommand": "python manage.py collectstatic --noinput",
    "builds": [{
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "includeFiles": ["staticfiles/**"]
      }
    }],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "config/wsgi.py"
      }
    ]
}
